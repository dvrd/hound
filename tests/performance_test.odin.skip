#+feature global-context
package main

import "core:fmt"
import "core:time"
import "../src"

main :: proc() {
	db_path := "/tmp/test_perf.db"

	// Test 1: Database open
	start := time.now()
	db, err := src.database_open(db_path)
	open_duration := time.since(start)
	if err != .None {
		fmt.println("Failed to open database")
		return
	}
	defer src.database_close(db)

	// Test 2: Schema creation
	start = time.now()
	schema_err := src.create_schema(db)
	schema_duration := time.since(start)
	if schema_err != .None {
		fmt.println("Failed to create schema")
		return
	}

	// Test 3: Token insert
	test_token := src.Token{
		symbol           = "PERF",
		name             = "Performance Test Token",
		contract_address = "PerfTestAddr123",
		chain            = "solana",
		is_quote_token   = false,
		usd_price        = 1.0,
		pools            = []src.PoolInfo{},
	}

	start = time.now()
	insert_err := src.insert_token(db, test_token)
	insert_duration := time.since(start)
	if insert_err != .None {
		fmt.println("Failed to insert token")
		return
	}

	// Test 4: Token SELECT (by symbol)
	start = time.now()
	token, found, get_err := src.get_token_by_symbol(db, "PERF")
	select_duration := time.since(start)
	if get_err != .None || !found {
		fmt.println("Failed to get token")
		return
	}

	// Test 5: Integrity check
	start = time.now()
	ok := src.database_integrity_check(db)
	integrity_duration := time.since(start)
	if !ok {
		fmt.println("Integrity check failed")
		return
	}

	// Print results
	fmt.println("=== Database Performance Tests ===")
	fmt.println()
	fmt.printf("Database open:        %v\n", open_duration)
	fmt.printf("Schema creation:      %v\n", schema_duration)
	fmt.printf("Token insert:         %v\n", insert_duration)
	fmt.printf("Token SELECT:         %v\n", select_duration)
	fmt.printf("Integrity check:      %v\n", integrity_duration)
	fmt.println()

	// Check against requirements
	select_ms := time.duration_milliseconds(select_duration)
	insert_ms := time.duration_milliseconds(insert_duration)

	fmt.println("=== Performance Requirements ===")
	fmt.printf("SELECT query:  %.2fms (target: <10ms) %s\n",
		select_ms, select_ms < 10 ? "✓ PASS" : "✗ FAIL")
	fmt.printf("INSERT query:  %.2fms (target: <50ms) %s\n",
		insert_ms, insert_ms < 50 ? "✓ PASS" : "✗ FAIL")
}
