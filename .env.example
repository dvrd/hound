# Hound Configuration
# Copy this file to .env or set these environment variables

# Solana RPC Endpoint
# Default: https://api.mainnet-beta.solana.com (public, slow, free)
#
# Recommended: Use a managed RPC service for better performance
#
# Helius (Recommended - Fast & Free tier):
#   1. Sign up at: https://dashboard.helius.dev/signup
#   2. Create an API key in the dashboard
#   3. Set: HOUND_RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
#
# QuickNode:
#   HOUND_RPC_ENDPOINT=https://your-endpoint.quiknode.pro/YOUR_KEY/
#
# Alchemy:
#   HOUND_RPC_ENDPOINT=https://solana-mainnet.g.alchemy.com/v2/YOUR_API_KEY
#
# Ankr:
#   HOUND_RPC_ENDPOINT=https://rpc.ankr.com/solana

HOUND_RPC_ENDPOINT=https://api.mainnet-beta.solana.com
