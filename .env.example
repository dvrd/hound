# Solana RPC endpoint (required for full history and reliable data)
# Get a free key at https://helius.dev
HOUND_RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY

# Helius Gatekeeper endpoint (optional, used as backup)
HOUND_GATEKEEPER_RPC_ENDPOINT=https://beta.helius-rpc.com/?api-key=YOUR_API_KEY
